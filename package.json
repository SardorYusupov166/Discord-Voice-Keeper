{
  "name": "discord-voice-keeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/keeper.js && node --check src/commands.js && node --check src/storage.js && node --check src/whitelist-cli.js",
    "test": "node --test",
    "whitelist:add": "node src/whitelist-cli.js add",
    "whitelist:remove": "node src/whitelist-cli.js remove",
    "whitelist:list": "node src/whitelist-cli.js list",
    "whitelist:check": "node src/whitelist-cli.js check"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1"
  }
}
